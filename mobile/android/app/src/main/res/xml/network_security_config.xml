<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is enabled so local Wi-Fi test APKs can reach http://<PC-IP>:8000.
  Prefer HTTPS (Cloudflare Tunnel / ngrok) for Firebase App Distribution builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

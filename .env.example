# API settings (optional — defaults work for local development)
OCR_MODE=fast
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
USE_SQLITE=true
SQLITE_PATH=data/database/medicines.db

# YOLO weights path (optional — defaults to runs/detect/.../best.pt)
# YOLO_MODEL_PATH=runs/detect/runs/detect/medicine_box_yolov8n-2/weights/best.pt

# Docker Compose overrides (see docker-compose.yml)
# YOLO_MODEL_HOST_PATH=./runs/detect/runs/detect/medicine_box_yolov8n-2/weights/best.pt

# API settings (copy to .env — never commit .env)
ENVIRONMENT=development
OCR_MODE=fast
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
USE_SQLITE=true
SQLITE_PATH=data/database/medicines.db
USE_GPU=false

# CORS: comma-separated origins; use * only for local dev
# In production "*" is rejected at startup — set explicit origins.
CORS_ORIGINS=*

# Rate limit for POST /api/v1/analyze (per client IP per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_PER_MINUTE=20

# Production example (also used by docker-compose via .env):
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-app.example.com
# RATE_LIMIT_ANALYZE_PER_MINUTE=10
# /docs, /redoc, and /openapi.json are disabled when ENVIRONMENT=production

# YOLO weights path (optional — defaults to runs/detect/.../best.pt)
# YOLO_MODEL_PATH=runs/detect/runs/detect/medicine_box_yolov8n-2/weights/best.pt

# ---------------------------------------------------------------------------
# Explain / LLM (POST /api/v1/explain) — key + cache + rate limit
# ---------------------------------------------------------------------------
# 1) Set a real Gemini key from https://aistudio.google.com/apikey
# 2) Enable the feature
# 3) Keep cache + rate limit on (recommended)
#
# LLM_ENABLED=true
# GEMINI_API_KEY=AIza...your_real_key...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest
# LLM_CACHE_ENABLED=true
# LLM_MOCK_MODE=false
RATE_LIMIT_EXPLAIN_PER_MINUTE=5

# Local/dev without a Gemini key (deterministic mock text):
# LLM_ENABLED=true
# LLM_MOCK_MODE=true

# Check readiness: GET /api/v1/explain/info  (ready=true when configured)

# Server scan history (SQLite `scans` table; no auth yet — global list)
# SCAN_HISTORY_MAX_ENTRIES=200
# RATE_LIMIT_SCANS_PER_MINUTE=30

# Docker Compose overrides (see docker-compose.yml)
# YOLO_MODEL_HOST_PATH=./runs/detect/runs/detect/medicine_box_yolov8n-2/weights/best.pt
